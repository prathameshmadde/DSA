class Q32PrintThreeDigit
{
	public static void main(String[] args) 
	{
		int [] arr = {10,20,40,33,52};
		printThreedigit(arr);
	}
	public static void printThreedigit(int [] num ){
		int count = 0; 
		for (int a : num)
		{	
			if (a >99 && a <1000)
			{
				count ++ ;
				System.out.println( a);
			}
			
		}
		if(count==0){
			System.out.println("NO Three digit.");
		}
		
	}
}