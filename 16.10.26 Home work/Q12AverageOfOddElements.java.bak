class  Q12AverageOfOddElements
{
	public static void main(String[] args) 
	{	int [] a = {12, 15, 18, 21, 24, 27};
		System.out.println("Average of Odd elements = "+avgOdd(a) );
	}
	public static int avgOdd(int [] num){
		int sum = 0; 
		int count = 0;
		for (int i = 0 ; i< num.length ; i++ )
		{
			if (num[i] % 2 !=0 )
			{
				count ++;
				sum =sum + num [i] ;
			}
		}
		
		return sum / count; //18
	}
}