class Q8SumOfNegative 
{
	public static void main(String[] args) 
	{	int [] a = {-10, 20, -30, 40, 50};
		System.out.println("Sum of Negative Elements = " + sumOfNegative(a) );
	}
	public static int sumOfNegative( int [] num ){
		int sum = 0 ; 
		for (int i = 0 ; i < num.length ; i++ )
		{
			if(num[i]<0){
				sum = sum + num[i];
			}
		}
		return sum ;
	}
}
